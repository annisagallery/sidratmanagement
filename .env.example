# Public HTTPS origin of the API, without /api or a trailing slash.
NEXT_PUBLIC_BASE_URL=https://api.example.com

# Public HTTPS origin of the customer storefront, without a trailing slash.
NEXT_PUBLIC_FRONTEND_URL=https://www.example.com

# Storefront origin the homepage builder frames for its live preview.
# Optional: when it is empty the builder reads "Storefront URL" from
# Settings -> Branding, which is the recommended way to set it because it needs
# no rebuild. Set here only to pin the value.
# NEXT_PUBLIC_SITE_URL=https://www.example.com
